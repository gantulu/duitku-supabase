# Template only. Never commit a populated .env file.
# Edge Function runtime needs these values configured locally or in Supabase secrets.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=replace_with_sandbox_merchant_code
DUITKU_API_KEY=replace_with_sandbox_api_key
DUITKU_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/duitku-callback
DUITKU_RETURN_URL=https://your-store.example/payment/return
# Populate only with the exact HTTPS payment host(s) returned/approved for your merchant account.
DUITKU_ALLOWED_PAYMENT_HOSTS=replace_with_verified_payment_host
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
